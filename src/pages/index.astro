---
import Layout from "@/layouts/Layout.astro";
import ObfuscatedEmail from "@/components/ObfuscatedEmail.astro";
---

<Layout title="KICstart Partners" minimal>
  <main class="landing">
    <div class="landing-card">
      <img
        src="/kicstart-logo.svg"
        alt="KICstart Partners logo"
        class="landing-logo"
        width="240"
        height="240"
      />
      <ObfuscatedEmail user="sandy" domain="kicstartpartners" tld="com" label="" />
    </div>
  </main>
  <style>
    :global(body) {
      margin: 0;
      min-height: 100vh;
      font-family: "InterVariable", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI",
        sans-serif;
      background: radial-gradient(circle at top, #f8faff 0%, #e8f0ff 65%, #dfe4f6 100%);
      color: #1b2431;
    }

    .landing {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .landing-card {
      text-align: center;
      display: grid;
      gap: 1.5rem;
      padding: 3rem;
      border-radius: 32px;
      background: rgba(255, 255, 255, 0.9);
      box-shadow: 0 20px 60px rgba(27, 36, 49, 0.16);
      max-width: 460px;
      width: 100%;
    }

    .landing-logo {
      margin: 0 auto;
    }

    /* Email as plain obfuscated text */
    #obf-email { font-size: 1rem; color: #223147; }

    @media (max-width: 600px) {
      .landing-card {
        padding: 2.25rem;
        border-radius: 24px;
      }

      #obf-email { width: 100%; display: block; }
    }
  </style>
</Layout>
